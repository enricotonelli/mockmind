# Frontend
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database (usar Supabase para producción)
DATABASE_URL="postgresql://user:password@localhost:5432/mockmind_dev"

# JWT Secret (cambiar en producción a una cadena larga aleatoria)
JWT_SECRET="cambiar-esta-clave-en-produccion"

# AI SDK - Google Gemini (FREE TIER: 15 requests/min)
# Obtener en https://aistudio.google.com/apikey
# Free tier: suficiente para desarrollo, ~ 1-2 sesiones/día
GOOGLE_GENERATIVE_AI_API_KEY="AIz..."

# Modelo de Gemini (gemini-2.5-flash es rápido y está en el free tier)
GOOGLE_GENERATIVE_AI_MODEL="gemini-2.5-flash"

# NOTA: Voz (STT/TTS) usa Web Speech API del navegador (100% gratis, no requiere backend)
# Ver: src/components/PanelRespuestaConVoz.jsx
