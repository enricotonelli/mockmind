# Copiar este archivo a .env y completar con valores reales.
# .env NUNCA se sube al repositorio (ver .gitignore).

# Cadena de conexión a PostgreSQL (Supabase o local).
# Ejemplo Supabase: postgresql://usuario:password@host:5432/postgres
DATABASE_URL="postgresql://usuario:password@localhost:5432/mockmind"

# String largo y aleatorio usado para firmar los JWT de sesión.
# Generar uno con: openssl rand -base64 32
JWT_SECRET="reemplazar-por-un-secreto-aleatorio"

# API key de Anthropic (console.anthropic.com), distinta de la suscripción de Claude Code.
ANTHROPIC_API_KEY="sk-ant-..."

# Puerto donde levanta el servidor Express.
PORT=3000
