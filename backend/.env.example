# ============================================================================
# ARCHIVO ÚNICO DE CREDENCIALES DE MOCKMIND
# ============================================================================
# Copiar este archivo a .env (mismo directorio) y completar los 3 valores
# marcados como OBLIGATORIO. .env nunca se sube al repositorio (ver
# .gitignore) y ninguna de estas claves debe pegarse en ningún otro lugar.
#
#   cp backend/.env.example backend/.env
#
# Con eso completo, arrancás el backend con: npm run dev (desde backend/)
# ============================================================================


# --- 1) Base de datos PostgreSQL — OBLIGATORIO -----------------------------
# Cadena de conexión completa. La forma más simple es crear un proyecto
# gratis en Supabase (supabase.com) y copiar el "Connection string" → "URI".
# También sirve un PostgreSQL local.
# Ejemplo Supabase: postgresql://postgres:TU_PASSWORD@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://usuario:password@localhost:5432/mockmind"


# --- 2) API key de Anthropic — OBLIGATORIO ----------------------------------
# Se genera en console.anthropic.com (es una cuenta distinta a la
# suscripción de Claude / Claude Code). Es la que hace funcionar todo el
# motor de entrevistas: sin esto, el entrevistador no puede responder.
ANTHROPIC_API_KEY="sk-ant-..."

# Modelo de Claude a usar. No hace falta tocarlo salvo que quieras probar
# otro modelo o Anthropic saque una versión nueva.
CLAUDE_MODEL="claude-sonnet-5"

# Modelo para el motor de entrevistas (más barato). Usa Haiku por defecto
# para optimizar costos: ~0.8 USD por millón de tokens de entrada,
# ~4 USD por millón de salida (vs Sonnet: ~3/$15).
CLAUDE_INTERVIEW_MODEL="claude-haiku-4-5-20251001"


# --- 3) API key de OpenAI — OBLIGATORIO para voz ----------------------------
# Se genera en platform.openai.com (cuenta distinta a ChatGPT). Se usa para:
# - Transcribir audio (Whisper)
# - Generar voz desde texto (TTS)
# Es barato: Whisper cuesta ~$0.01/min, TTS ~$0.015 por 1000 caracteres
OPENAI_API_KEY="sk-..."


# --- 4) Secreto para firmar los tokens de sesión (JWT) — OBLIGATORIO -------
# Cualquier string largo y aleatorio. Generar uno con:
#   openssl rand -base64 32
JWT_SECRET="reemplazar-por-un-secreto-aleatorio"


# --- Configuración del servidor — opcional, ya vienen con un valor por defecto
# Puerto donde levanta el backend.
PORT=3000

# Origen permitido para CORS (la URL del frontend). Sin definir, en
# desarrollo se acepta cualquier origen para no tener que tocar esto al
# levantar el frontend en otro puerto. En producción conviene fijarlo, por
# ejemplo: CORS_ORIGIN="https://mi-mockmind.vercel.app"
CORS_ORIGIN=
