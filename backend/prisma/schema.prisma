// Schema de la base de datos de MockMind — Módulo 1 (motor de entrevistas)
// Ver CLAUDE.md §6 para la definición funcional de cada tabla.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoEntrevista {
  RRHH
  Tecnica
  Estres
}

enum RolMensaje {
  usuario
  entrevistador
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  email         String   @unique
  password      String
  fechaRegistro DateTime @default(now()) @map("fecha_registro")
  sesiones      Sesion[]

  @@map("usuarios")
}

model Sesion {
  id                Int                @id @default(autoincrement())
  usuarioId         Int                @map("id_usuario")
  usuario           Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  puestoAplicado    String             @map("puesto_aplicado")
  tipoEntrevista    TipoEntrevista     @map("tipo_entrevista")
  // Cuántas preguntas tiene esta entrevista (el usuario elige duración al
  // configurarla: corta/completa/extendida). No es un valor fijo global.
  cantidadPreguntas Int                @default(6) @map("cantidad_preguntas")
  // El resto del estado del motor (qué pregunta va, cuántas repreguntas
  // seguidas lleva) NO se persiste acá: se reconstruye leyendo los mensajes
  // de la sesión cada vez (ver services/entrevistador.service.js), así no
  // hay dos fuentes de verdad para lo mismo.
  finalizada        Boolean            @default(false)
  fecha             DateTime           @default(now())
  duracion          Int?
  puntajeGeneral    Float?             @map("puntaje_general")
  mensajes          Mensaje[]
  reporte           ReporteEntrevista?

  @@map("sesiones")
}

model Mensaje {
  id           Int        @id @default(autoincrement())
  sesionId     Int        @map("id_sesion")
  sesion       Sesion     @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  rol          RolMensaje
  contenido    String
  // Si este mensaje del entrevistador fue una repregunta (en vez de la
  // siguiente pregunta del guion). Es lo que permite reconstruir el estado
  // del motor sin guardarlo aparte.
  esRepregunta Boolean    @default(false) @map("es_repregunta")
  timestamp    DateTime   @default(now())

  @@map("mensajes")
}

model ReporteEntrevista {
  id                  Int    @id @default(autoincrement())
  sesionId            Int    @unique @map("id_sesion")
  sesion              Sesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  puntajeClaridad     Float  @map("puntaje_claridad")
  puntajeStar         Float  @map("puntaje_star")
  puntajeEjemplos     Float  @map("puntaje_ejemplos")
  puntajeCoherencia   Float  @map("puntaje_coherencia")
  cantidadRepreguntas Int    @map("cantidad_repreguntas")
  feedbackTexto       String @map("feedback_texto")
  sugerencias         String

  @@map("reportes_entrevista")
}
