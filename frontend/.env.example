# Copiar a .env si se quiere cambiar la configuración por defecto.
# El frontend funciona sin este archivo: los valores de abajo son los que usa
# por defecto.

# "true"        => fuerza modo demostración: nunca intenta tocar el backend,
#                  todo el entrevistador y los datos son simulados.
# sin definir,
# o "false"     => intenta usar el backend real en VITE_API_URL. Si en algún
#                  momento el backend no responde (está apagado, no hay
#                  conexión, se cayó a mitad de una sesión), esa llamada
#                  puntual cae sola a datos simulados, sin romper la pantalla.
#                  Es decir: si nunca se levanta el backend, la app queda
#                  funcionando en modo demostración igual, sin tener que
#                  tocar esta variable.
VITE_USE_MOCKS=false

# URL del backend. Se usa siempre que VITE_USE_MOCKS no sea "true".
VITE_API_URL=http://localhost:3000/api
