# Copiar a .env si se quiere cambiar la configuración por defecto.
# El frontend funciona sin este archivo: los valores de abajo son los que usa
# por defecto.

# "true" (o sin definir) => modo demostración: datos y entrevistador simulados,
# la app funciona sin backend, sin base de datos y sin internet.
# "false" => consume el backend real en VITE_API_URL.
VITE_USE_MOCKS=true

# URL del backend, se usa solo cuando VITE_USE_MOCKS=false.
VITE_API_URL=http://localhost:3000/api
